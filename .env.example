# Copy this file to .env.local and set the values in the deployment environment.
# Do not commit real database or Cloudinary credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GEMINI_API_KEYS=key1,key2,key3,key4
# Optional secret for MCP Server protection (timingSafeEqual). If omitted, the MCP endpoint remains open.
MCP_SECRET=your_optional_mcp_secret_token
